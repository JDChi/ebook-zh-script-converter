{
  "name": "shuzi-epub-converter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:wasm": "node scripts/copy-opencc-assets.mjs",
    "predev": "npm run prepare:wasm",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:wasm",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretest": "npm run prepare:wasm",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "opencc-wasm": "0.13.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
